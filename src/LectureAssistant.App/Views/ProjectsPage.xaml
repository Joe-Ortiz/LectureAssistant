<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LectureAssistant.App.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LectureAssistant.App.ViewModels">

    <Grid Padding="32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lectures" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Import a recording, review its captions and questions, then export for your LMS."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="NewLecture_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="New lecture from video" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="No lectures yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Choose a lecture recording (MP4, MOV, MKV…). Captions are generated on this PC; the video isn't uploaded anywhere." />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Projects}" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Projects_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectSummary">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE714;" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Modified}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="3" Tag="{x:Bind}" Click="Delete_Click" ToolTipService.ToolTip="Delete lecture"
                                AutomationProperties.Name="Delete lecture" Background="Transparent" BorderThickness="0">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
