<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LectureAssistant.App.Views.LecturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LectureAssistant.App.ViewModels">

    <Page.Resources>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,12,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="24" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"
                     PlaceholderText="Lecture title" AutomationProperties.Name="Lecture title" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Command="{x:Bind ViewModel.PreviewCommand}" ToolTipService.ToolTip="Try the lecture exactly as students will see it" AutomationProperties.Name="Preview as student">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                        <TextBlock Text="Preview as student" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SaveCommand}" ToolTipService.ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Save" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <StackPanel Grid.Row="1" Spacing="8">
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <Grid ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Column="1" Grid.RowSpan="2" Content="Cancel" Command="{x:Bind ViewModel.CancelOperationCommand}" />
                    <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.LiveText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Title="Something needs attention"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" CloseButtonClick="ErrorBar_Closed" />
            <InfoBar Severity="Success" IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                     Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" CloseButtonClick="SuccessBar_Closed" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="4*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Video preview -->
            <StackPanel Spacing="8">
                <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform"
                                    MinHeight="220" AutomationProperties.Name="Lecture video preview" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="AddQuestionHere_Click" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" AutomationProperties.Name="Add question at current time">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Add question at current time" />
                        </StackPanel>
                    </Button>
                    <Button Click="RefreshPreview_Click" ToolTipService.ToolTip="Reload the preview with your caption edits" AutomationProperties.Name="Refresh captions in preview">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Refresh captions in preview" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="MissingVideoText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Text="The original video file can't be found, so there's no preview. You can still edit questions and export." />
            </StackPanel>

            <!-- Steps -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="Steps" SelectionChanged="Steps_SelectionChanged">
                    <SelectorBarItem x:Name="CaptionsStep" Text="1. Captions" IsSelected="True" />
                    <SelectorBarItem x:Name="QuestionsStep" Text="2. Questions" />
                    <SelectorBarItem x:Name="PublishStep" Text="3. Publish" />
                </SelectorBar>

                <!-- Step 1: captions -->
                <Grid x:Name="CaptionsPanel" Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasNoCaptions, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Generate captions" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Speech recognition runs on this PC, so the recording stays private. The first run downloads the speech model." />
                            <TextBox Header="Names and terms used in this lecture (optional)"
                                     PlaceholderText="e.g. Schrödinger, eigenvalue, Dr. Okonkwo, CRISPR-Cas9"
                                     Text="{x:Bind ViewModel.Vocabulary, Mode=TwoWay}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.TranscribeCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" Content="Generate captions" />
                                <Button Command="{x:Bind ViewModel.ImportCaptionsCommand}" Content="Import .vtt / .srt" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Visibility="{x:Bind ViewModel.HasCaptions, Mode=OneWay}" RowSpacing="8" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True">
                            <AppBarButton Icon="Save" Label="Save .srt" Command="{x:Bind ViewModel.ExportCaptionsCommand}" CommandParameter="srt" />
                            <AppBarButton Icon="Save" Label="Save .vtt" Command="{x:Bind ViewModel.ExportCaptionsCommand}" CommandParameter="vtt" />
                            <AppBarButton Icon="OpenFile" Label="Import" Command="{x:Bind ViewModel.ImportCaptionsCommand}" />
                            <AppBarButton Icon="Refresh" Label="Regenerate" Command="{x:Bind ViewModel.TranscribeCommand}"
                                          IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                        </CommandBar>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Captions}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CaptionViewModel">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <HyperlinkButton Content="{x:Bind StartText}" Command="{x:Bind JumpCommand}" VerticalAlignment="Top"
                                                         ToolTipService.ToolTip="Play from here" Padding="4,5" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                                 AutomationProperties.Name="Caption text" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Step 2: questions -->
                <ScrollViewer x:Name="QuestionsPanel" Grid.Row="1" Visibility="Collapsed" Padding="0,0,16,0">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Suggest questions from the transcript" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.QuestionProviderText, Mode=OneWay}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <NumberBox Header="How many" Value="{x:Bind ViewModel.QuestionCount, Mode=TwoWay}" Minimum="1" Maximum="50"
                                               SpinButtonPlacementMode="Compact" Width="120" />
                                    <StackPanel>
                                        <TextBlock Text="Types" Margin="0,0,0,4" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <CheckBox Content="Multiple choice" IsChecked="{x:Bind ViewModel.IncludeMultipleChoice, Mode=TwoWay}" />
                                            <CheckBox Content="True / false" IsChecked="{x:Bind ViewModel.IncludeTrueFalse, Mode=TwoWay}" />
                                            <CheckBox Content="Fill in the blank" IsChecked="{x:Bind ViewModel.IncludeFillInTheBlank, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <TextBox Header="Guidance (optional)" TextWrapping="Wrap" AcceptsReturn="True"
                                         PlaceholderText="e.g. Intro-level students. Focus on the derivation in the second half; skip the history."
                                         Text="{x:Bind ViewModel.Guidance, Mode=TwoWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="Suggest questions"
                                            Command="{x:Bind ViewModel.GenerateQuestionsCommand}" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                                    <CheckBox Content="Replace existing questions" IsChecked="{x:Bind ViewModel.ReplaceExistingQuestions, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <TextBlock Text="Questions" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Content="Sort by time" Command="{x:Bind ViewModel.SortQuestionsCommand}" />
                        </Grid>
                        <TextBlock Visibility="{x:Bind ViewModel.HasNoQuestions, Mode=OneWay}"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="No questions yet. Suggest some above, or pause the video and choose &quot;Add question at current time&quot;." />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Questions}">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection />
                            </ItemsControl.ItemContainerTransitions>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuestionViewModel">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Width="90" Header="Time" Text="{x:Bind TimestampText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="Question time" />
                                                <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind JumpCommand}"
                                                        ToolTipService.ToolTip="Play from this point" AutomationProperties.Name="Play from this point">
                                                    <SymbolIcon Symbol="Play" />
                                                </Button>
                                                <ComboBox Grid.Column="2" Header="Type" ItemsSource="{x:Bind vm:QuestionViewModel.TypeNames}"
                                                          SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}" MinWidth="170" />
                                                <NumberBox Grid.Column="3" Header="Points" Value="{x:Bind Points, Mode=TwoWay}" Minimum="1" Maximum="100" Width="90" />
                                                <Button Grid.Column="4" VerticalAlignment="Bottom" Command="{x:Bind RemoveCommand}"
                                                        ToolTipService.ToolTip="Delete question" AutomationProperties.Name="Delete question">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Button>
                                            </Grid>

                                            <TextBox Header="Question" Text="{x:Bind Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" />

                                            <StackPanel Spacing="6" Visibility="{x:Bind IsMultipleChoice, Mode=OneWay}">
                                                <TextBlock Text="Options (check every correct answer)" />
                                                <ItemsControl ItemsSource="{x:Bind Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:OptionViewModel">
                                                            <Grid ColumnSpacing="6" Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{x:Bind IsCorrect, Mode=TwoWay}" MinWidth="0"
                                                                          AutomationProperties.Name="Correct answer" ToolTipService.ToolTip="Correct answer" />
                                                                <TextBox Grid.Column="1" Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         PlaceholderText="Answer option" AutomationProperties.Name="Answer option" />
                                                                <Button Grid.Column="2" Command="{x:Bind RemoveCommand}" AutomationProperties.Name="Remove option"
                                                                        ToolTipService.ToolTip="Remove option">
                                                                    <SymbolIcon Symbol="Cancel" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <HyperlinkButton Content="+ Add option" Command="{x:Bind AddOptionCommand}" />
                                            </StackPanel>

                                            <ToggleSwitch Header="Correct answer" OnContent="True" OffContent="False"
                                                          IsOn="{x:Bind CorrectAnswer, Mode=TwoWay}" Visibility="{x:Bind IsTrueFalse, Mode=OneWay}" />

                                            <TextBox Header="Accepted answers (separate with ;)" Visibility="{x:Bind IsFillInTheBlank, Mode=OneWay}"
                                                     Text="{x:Bind AcceptedAnswersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="mitochondria; mitochondrion" />

                                            <TextBox Header="Explanation shown after answering" TextWrapping="Wrap" AcceptsReturn="True"
                                                     Text="{x:Bind Explanation, Mode=TwoWay}" />

                                            <TextBlock Visibility="{x:Bind HasSourceExcerpt, Mode=OneWay}" TextWrapping="Wrap" FontStyle="Italic"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="From the lecture: " /><Run Text="{x:Bind SourceExcerpt, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Visibility="{x:Bind HasProblems, Mode=OneWay}" Text="{x:Bind ProblemsText, Mode=OneWay}"
                                                       TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Step 3: publish -->
                <ScrollViewer x:Name="PublishPanel" Grid.Row="1" Visibility="Collapsed" Padding="0,0,16,0">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Check it before you publish" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="Watch and answer the questions exactly as a student would, and see the score your LMS would record. Works before the video is on YouTube, too." />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Command="{x:Bind ViewModel.PreviewCommand}" AutomationProperties.Name="Preview as student">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                                        <TextBlock Text="Preview as student" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Put the video on YouTube" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="1. Upload the video in YouTube Studio and set visibility to " /><Run Text="Unlisted" FontWeight="SemiBold" /><Run Text=" (only people with the link can watch)." />
                                    <LineBreak /><Run Text="2. In the video's Subtitles page, upload the .srt file from step 1 (With timing), so captions show for students." />
                                    <LineBreak /><Run Text="3. Paste the video link below." />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open YouTube Studio" Click="OpenYouTubeStudio_Click" />
                                    <Button Content="Save captions (.srt)" Command="{x:Bind ViewModel.ExportCaptionsCommand}" CommandParameter="srt"
                                            IsEnabled="{x:Bind ViewModel.HasCaptions, Mode=OneWay}" />
                                </StackPanel>
                                <TextBox Header="YouTube link" PlaceholderText="https://youtu.be/…"
                                         Text="{x:Bind ViewModel.YouTubeUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{x:Bind ViewModel.YouTubeStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Quiz settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <NumberBox Header="Passing score (%)" Value="{x:Bind ViewModel.PassingScore, Mode=TwoWay}" Minimum="0" Maximum="100"
                                           SpinButtonPlacementMode="Compact" Width="160" HorizontalAlignment="Left" />
                                <CheckBox Content="Don't let students skip past a question they haven't answered"
                                          IsChecked="{x:Bind ViewModel.PreventSkippingAhead, Mode=TwoWay}" />
                                <CheckBox Content="Let students retry wrong answers (only the first attempt counts)"
                                          IsChecked="{x:Bind ViewModel.AllowRetry, Mode=TwoWay}" />
                                <CheckBox Content="Show the correct answer and explanation after answering"
                                          IsChecked="{x:Bind ViewModel.ShowCorrectAnswers, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Export for Canvas (SCORM)" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Recommended. Upload the .zip to Canvas as a graded SCORM assignment: Canvas knows who each student is and records their score in the gradebook. Also works in Moodle, Blackboard and D2L." />
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Export SCORM package…"
                                        Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="scorm" IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Export H5P Interactive Video" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="For schools with an H5P platform (H5P.com, Moodle, WordPress, Lumi). Scores go wherever your H5P platform sends them." />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="Optional: choose any Interactive Video you exported from your own H5P platform. The export will then use exactly the H5P versions your platform has installed." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choose reference .h5p…" Command="{x:Bind ViewModel.BrowseH5PReferenceCommand}" />
                                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearH5PReferenceCommand}" />
                                    <TextBlock Text="{x:Bind ViewModel.H5PReferenceText, Mode=OneWay}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Content="Export .h5p…" Command="{x:Bind ViewModel.ExportCommand}" CommandParameter="h5p"
                                        IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
