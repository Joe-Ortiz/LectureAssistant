<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LectureAssistant.App.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Student preview">

    <Grid>
        <WebView2 x:Name="Web" />

        <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="40" Height="40" />
            <TextBlock Text="Opening the student preview…" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12" MaxWidth="520" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="The preview couldn't open" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
